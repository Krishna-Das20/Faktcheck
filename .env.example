# ── Database ─────────────────────────────────────────────────────────────────
# Use a DEDICATED database name for production (not the default "test").
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/faktcheck?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (Google Identity Services client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=FaktCheck <noreply@yourdomain.com>

# ── App URL (used in emails: reset links, invite links) ──────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legacy fallback used by some email templates
CLIENT_URL=http://localhost:3000

# ── Judge0 (code execution) ──────────────────────────────────────────────────
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# ── Cloudinary (image/file uploads) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── NVIDIA NIM (AI question drafting — optional) ─────────────────────────────
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Cron protection ──────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
# REQUIRED in production — without it the cron endpoint is publicly callable.
CRON_SECRET=change-me-to-a-random-secret
